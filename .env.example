# Environment variable names (no secrets)

Copy to `.env` locally and fill values. Never commit `.env`.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (docker-compose defaults shown for local demo)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=growth_intelligence
POSTGRES_USER=growth
POSTGRES_PASSWORD=growth

# Synthetic seed (labelled demo data — not real company data)
SYNTHETIC_SEED=42
SYNTHETIC_DAYS=90

# YouTube (Phase 3+) — real public Data API ingest
# Get a free key: https://console.cloud.google.com/ → enable YouTube Data API v3
# Never commit the key. Guide: docs/guides/youtube-demo-ingest.md
YOUTUBE_API_KEY=
# Public demo channel (PBS Two Cents — personal finance education). Override anytime.
YOUTUBE_CHANNEL_ID=UCL8w_A8p8P1HWI3k6PR5Z6w
YOUTUBE_TIMEOUT_SECONDS=30
YOUTUBE_MAX_RETRIES=3
# Keep small for first demo runs (quota-friendly)
YOUTUBE_MAX_PAGES=2

# Anthropic (Phase 10+) — content classification.
# Get a key: https://console.anthropic.com → API Keys. Never commit it.
# Without a key the pipeline falls back to deterministic keyword labels.
ANTHROPIC_API_KEY=
# Leave blank to use the default model (claude-opus-5)
LLM_MODEL=
LLM_BATCH_SIZE=40

# Corporate TLS interception (Zscaler & co): Python's certifi bundle lacks the
# corporate root CA, so HTTPS fails in Python while curl succeeds. Point this at
# the system bundle — usually /etc/ssl/certs/ca-certificates.crt on Debian/Ubuntu.
CA_BUNDLE_PATH=

# Langfuse (Phase 8+) — optional; leave empty for local CI/demos without tracing
# Create keys in Langfuse Cloud → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud default; US: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional
DATABASE_URL=
