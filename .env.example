# Environment variable names (no secrets)

Copy to `.env` locally and fill values. Never commit `.env`.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=growth_intelligence
POSTGRES_USER=growth
POSTGRES_PASSWORD=

# YouTube (Phase 3+)
YOUTUBE_API_KEY=

# LLM provider (abstraction; Phase 5+)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Langfuse (Phase 8+)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Optional
DATABASE_URL=
